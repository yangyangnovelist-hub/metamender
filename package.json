{
  "name": "metamender",
  "version": "0.1.0",
  "description": "A governance-steward agent for DataHub: sweep the metadata graph for governance gaps, explain each in plain English, and on explicit per-item confirmation write the fix back through the official DataHub MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "steward": "./steward/src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/datahubClient.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan": "tsx steward/src/cli.ts scan",
    "agent": "tsx agent/src/cli.ts run"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "datahub",
    "mcp",
    "data-governance",
    "agent"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}

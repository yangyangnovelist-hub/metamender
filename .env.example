# MetaMender — DataHub MCP server connection config.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real tokens.

# GMS metadata service (REST), NOT the UI on :9002. The MCP server connects here.
DATAHUB_GMS_URL=http://localhost:8080

# On the local quickstart, Metadata-Service auth is OFF, so any placeholder works.
# If auth is enabled: generate a Personal Access Token in the DataHub UI
# (Settings -> Access Tokens) and paste it here.
DATAHUB_GMS_TOKEN=PLACEHOLDER_NO_AUTH

# Expose the 11 write tools (add_owners / add_terms / update_description / ...).
# Keep this false for standalone scans. `npm run agent` explicitly starts its
# writer session with mutation tools enabled, behind the per-finding safety gate.
TOOLS_IS_MUTATION_ENABLED=false
